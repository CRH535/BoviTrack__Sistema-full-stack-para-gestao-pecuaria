# Modelo sem valores. Copiar para backend/.env.release-production somente na etapa autorizada.
# Nao gerar nem colocar segredos de producao neste modelo.
BOVITRACK_RELEASE_SHA=
BOVITRACK_PRODUCTION_APPROVAL=
BOVITRACK_RELEASE_ADMIN_URL=
BOVITRACK_RELEASE_POOLER_HOST=
BOVITRACK_RELEASE_BACKUP_MANIFEST=
BOVITRACK_RELEASE_MAINTENANCE_STARTED_AT=
BOVITRACK_RELEASE_PRIVATE_BACKUP_DIR=
BOVITRACK_AUTHORIZE_PRIVATE_DATA_RESTORE=
DB_SSL=verify-full
DB_SSL_CA_PATH=
DB_RLS_CONTEXT_KEY=
BOVITRACK_AUTH_LOGIN_PASSWORD=
BOVITRACK_DOMAIN_LOGIN_PASSWORD=
# Conexoes runtime novas, sem reutilizar o login SQL legado.
DATABASE_URL=
DATABASE_AUTH_URL=
NODE_ENV=production
